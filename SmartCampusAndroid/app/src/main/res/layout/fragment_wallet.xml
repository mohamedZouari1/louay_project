<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- Hero Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:scaleType="centerCrop"
                android:src="@drawable/uma" />

            <View
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@drawable/gradient_primary"
                android:alpha="0.88" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wallet_balance"
                    android:textColor="@color/white"
                    android:alpha="0.85"
                    android:textSize="16sp" />

                <!-- LIVE BALANCE — updated from WalletFragment.java -->
                <TextView
                    android:id="@+id/tv_wallet_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="145.50 TND"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="38sp"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="24dp">

                    <!-- TOP UP BUTTON -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_top_up"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wallet_top_up"
                        app:icon="@android:drawable/ic_menu_add"
                        style="@style/Widget.Material3.Button"
                        android:layout_marginEnd="12dp"/>

                    <!-- PAY BUTTON -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wallet_pay"
                        app:icon="@android:drawable/ic_menu_send"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:strokeColor="@color/white"
                        android:textColor="@color/white"
                        app:iconTint="@color/white"/>
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Recent Transactions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wallet_history"
                style="@style/SectionTitle"
                android:layout_marginBottom="12dp" />

            <!-- Dynamic transaction list injected from WalletFragment.java -->
            <LinearLayout
                android:id="@+id/tx_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
