<?xml version="1.0" encoding="utf-8"?>
<!-- Premium LinkedIn-style "Start a Post" card -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="false"
    android:focusable="false"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clickable="false"
        android:focusable="false">

        <!-- Avatar + "Start a post" input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">
                <TextView
                    android:id="@+id/tv_header_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_avatar_circle" />
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_header_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_post"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:text="What's on your mind?"
                android:textColor="#666666"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:gravity="center_vertical|start"
                android:paddingStart="18dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="#D0D0D0"
                app:strokeWidth="1dp"
                app:cornerRadius="24dp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconTint="#999999"
                app:iconSize="18dp"
                app:iconGravity="end"
                app:iconPadding="8dp" />
        </LinearLayout>

        <!-- Thin separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:background="#EEEEEE" />

        <!-- Action row: Photo · Video · Article -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <!-- Photo -->
            <LinearLayout
                android:id="@+id/btn_header_photo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="#378FE9"
                    android:contentDescription="Photo" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Photo"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Vertical divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:background="#E0E0E0" />

            <!-- Video -->
            <LinearLayout
                android:id="@+id/btn_header_video"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="#5F9B41"
                    android:contentDescription="Video" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Video"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Vertical divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:background="#E0E0E0" />

            <!-- Article -->
            <LinearLayout
                android:id="@+id/btn_header_article"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#E06847"
                    android:contentDescription="Article" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Article"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
