<?xml version="1.0" encoding="utf-8"?>
<!-- LinkedIn-style post card -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp"
    android:background="@color/white">

    <!-- ── Author header ─────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Avatar circle with initials or photo -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">
            <TextView
                android:id="@+id/tv_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/bg_avatar_circle" />
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_author_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
        </FrameLayout>

        <!-- Name + tagline -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tv_author_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_university"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#666666"
                android:textSize="12sp"
                android:layout_marginTop="1dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="1dp">

                <TextView
                    android:id="@+id/tv_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#999999"
                    android:textSize="11sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · 🌐"
                    android:textColor="#999999"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Role badge (LinkedIn-style: "Student" / "Admin" / "Org") -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            app:chipMinHeight="22dp"
            app:chipStartPadding="6dp"
            app:chipEndPadding="6dp"
            style="@style/Widget.Material3.Chip.Assist" />

    </LinearLayout>

    <!-- ── Post content ──────────────────────────────── -->
    <TextView
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#1D1D1D"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.45"
        android:paddingHorizontal="12dp"
        android:paddingBottom="10dp"/>

    <!-- Elegant Post File/Document Attachment Card (Visible only when post has a document file attachment) -->
    <LinearLayout
        android:id="@+id/ll_post_file_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="10dp"
        android:padding="12dp"
        android:background="@drawable/bg_comment_preview"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_save"
            app:tint="#0A66C2"
            android:contentDescription="File icon"/>

        <TextView
            android:id="@+id/tv_post_file_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="attachment.pdf"/>
    </LinearLayout>

    <!-- ── Repost Container (optional) ─────────────── -->
    <LinearLayout
        android:id="@+id/ll_repost_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:padding="10dp"
        android:background="@drawable/bg_repost_border"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_repost_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_repost_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#333333"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <FrameLayout
            android:id="@+id/fl_repost_media_container"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:background="#F0F0F0">

            <ImageView
                android:id="@+id/iv_repost_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Repost media" />

            <ImageView
                android:id="@+id/iv_repost_play_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#80000000"
                app:tint="@color/white"
                android:padding="12dp"
                android:visibility="gone"
                android:contentDescription="Play Video" />
        </FrameLayout>
    </LinearLayout>

    <!-- ── Post media (optional: image or video preview) ── -->
    <FrameLayout
        android:id="@+id/fl_post_media_container"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:visibility="gone"
        android:background="#F0F0F0">

        <ImageView
            android:id="@+id/iv_post_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Post media" />

        <ImageView
            android:id="@+id/iv_play_button"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_media_play"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#80000000"
            app:tint="@color/white"
            android:padding="16dp"
            android:visibility="gone"
            android:contentDescription="Play Video" />
    </FrameLayout>

    <!-- ── Like count bar (e.g. 👍 12 others liked this) -->
    <LinearLayout
        android:id="@+id/ll_like_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👍 "
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tv_likes_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#666666"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E8E8"
        android:layout_marginHorizontal="12dp"/>

    <!-- ── LinkedIn-style reaction bar ──────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <!-- LIKE button -->
        <LinearLayout
            android:id="@+id/btn_like"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ib_like_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/btn_star_big_off"
                android:clickable="false"
                android:focusable="false"
                android:contentDescription="Like"/>

            <TextView
                android:id="@+id/tv_like_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Like"
                android:textColor="#666666"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- COMMENT button -->
        <LinearLayout
            android:id="@+id/btn_comment"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="Comment"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Comment"
                android:textColor="#666666"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- SHARE button -->
        <LinearLayout
            android:id="@+id/btn_repost"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_share"
                android:contentDescription="Share"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Repost"
                android:textColor="#666666"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ── Comment Preview Section ── -->
    <LinearLayout
        android:id="@+id/ll_comment_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_comment_author_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                android:background="#E0E0E0"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_comment_preview"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tv_comment_author_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_comment_content_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_view_more_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View all comments"
            android:textColor="#0A66C2"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:layout_marginStart="40dp"/>
    </LinearLayout>

</LinearLayout>
