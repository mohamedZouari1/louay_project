<?xml version="1.0" encoding="utf-8"?>
<!-- item_transaction.xml – Single row in the transactions RecyclerView -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Category icon in a coloured circle -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/iv_txn_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- Type + date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_txn_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transport Subscription"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tv_txn_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01 Jan 2027  09:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@color/text_secondary"
                    android:alpha="0.4" />

                <TextView
                    android:id="@+id/tv_txn_method"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D17"
                    android:textColor="@color/primary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Amount (negative / red) -->
        <TextView
            android:id="@+id/tv_txn_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- 30.00 TND"
            android:textColor="@color/amount_debit"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
